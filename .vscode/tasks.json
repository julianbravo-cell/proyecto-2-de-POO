                "${workspaceFolder}\\Src\\Camion.cpp",
                "${workspaceFolder}\\Src\\Carro.cpp",
                "${workspaceFolder}\\Src\\Caseta.cpp",
                "${workspaceFolder}\\Src\\Excepcion.cpp",
                "${workspaceFolder}\\Src\\Moto.cpp",
                "${workspaceFolder}\\Src\\Operador.cpp",
                "${workspaceFolder}\\Src\\Persona.cpp",
                "${workspaceFolder}\\Src\\Propietario.cpp",
                "${workspaceFolder}\\Src\\Registro.cpp",
                "${workspaceFolder}\\Src\\Vehiculo.cpp",
                "${workspaceFolder}\\Src\\main.cpp",
                "-o",
                "${workspaceFolder}\\Src\\main.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
